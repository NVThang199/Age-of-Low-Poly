[node name="Content" type="RichTextLabel" parent="HelpDialog/VBox" unique_id=1445771581]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Mouse Controls:[/b]
- Left Click: Select unit, building, animal, or resource. Drag to box-select.
- Right Click: Move, Gather (trees/berries/mines/meat), Construct, Attack.

[b]Keyboard Shortcuts:[/b]
- [color=yellow]B[/color]: Villager Economic Buildings menu (Granary, Storage Pit, Farm, House).
- [color=yellow]V[/color]: Villager Military Buildings menu (Barracks, Archery, Stable, Tower).
- [color=yellow]X / Esc[/color]: Cancel placement or return to main action menu.
- [color=yellow]F10 or ~[/color]: [b]DEVTOOL[/b] (Spawn any unit/animal/building, cheats, toggle fog).

[b]Wildlife & Meat:[/b]
- [b]Nai (Gazelle):[/b] Chạy trốn khi lại gần (150 thịt).
- [b]Voi (Elephant):[/b] Đánh trả khi bị đánh, câu về TC (300 thịt).
- [b]Sư tử & Cá sấu:[/b] Thú ăn thịt hung dữ, tự động săn mồi (100 thịt)."

